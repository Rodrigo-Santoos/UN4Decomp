+// UN4Decomp: threads auxiliares do rasterizador. Uma primitiva grande e dividida em blocos de linhas;
+// cada pixel continua sendo calculado exatamente igual (as linhas nao dependem umas das outras), entao o
+// resultado e o mesmo de uma thread so. UN4_GS_THREADS=0 desliga.
+namespace
+{
+    class Un4RasterPool
+    {
+    public:
+        static Un4RasterPool &get()
+        {
+            static Un4RasterPool pool;
+            return pool;
+        }
+
+        int workers() const { return static_cast<int>(m_threads.size()); }
+
+        // chama fn(chunk) para chunk em [0, chunks), usando as threads auxiliares + a thread atual
+        void run(int chunks, const std::function<void(int)> &fn)
+        {
+            if (chunks <= 0)
+                return;
+            if (m_threads.empty() || chunks == 1)
+            {
+                for (int c = 0; c < chunks; ++c)
+                    fn(c);
+                return;
+            }
+            // cada trabalho tem seus proprios contadores (na pilha de quem chamou); uma thread so mexe neles
+            // depois de pegar o trabalho com o mutex, e quem chamou so retorna quando nenhuma thread mais o usa
+            Job job;
+            job.fn = &fn;
+            job.chunks = chunks;
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_job = &job;
+                ++m_generation;
+            }
+            m_cv.notify_all();
+            work(job);
+            int spins = 0;
+            while (job.done.load(std::memory_order_acquire) < chunks)
+            {
+                if (++spins > 2000)
+                    std::this_thread::yield();
+            }
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_job = nullptr;
+            }
+            while (m_active.load(std::memory_order_acquire) != 0)
+                std::this_thread::yield();
+        }
+
+    private:
+        struct Job
+        {
+            const std::function<void(int)> *fn = nullptr;
+            int chunks = 0;
+            std::atomic<int> next{0};
+            std::atomic<int> done{0};
+        };
+
+        Un4RasterPool()
+        {
+            int n = 0;
+            const unsigned hw = std::thread::hardware_concurrency();
+            // deixa folga para a thread do EE, a de video, a do IOP e o som
+            n = hw > 4u ? static_cast<int>(std::min<unsigned>(hw - 3u, 5u)) : (hw >= 3u ? 1 : 0);
+            if (const char *v = std::getenv("UN4_GS_THREADS"))
+                n = std::max(0, std::min(16, std::atoi(v)));
+            for (int i = 0; i < n; ++i)
+                m_threads.emplace_back([this]() { loop(); });
+            if (n > 0)
+                std::cerr << "[un4gs] rasterizador com " << (n + 1) << " threads" << std::endl;
+        }
+
+        ~Un4RasterPool()
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_quit = true;
+                ++m_generation;
+            }
+            m_cv.notify_all();
+            for (auto &t : m_threads)
+                if (t.joinable())
+                    t.join();
+        }
+
+        static void work(Job &job)
+        {
+            for (;;)
+            {
+                const int c = job.next.fetch_add(1, std::memory_order_relaxed);
+                if (c >= job.chunks)
+                    break;
+                (*job.fn)(c);
+                job.done.fetch_add(1, std::memory_order_release);
+            }
+        }
+
+        void loop()
+        {
+            uint64_t seen = 0;
+            for (;;)
+            {
+                Job *job = nullptr;
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_cv.wait(lock, [&]() { return m_quit || (m_generation != seen && m_job != nullptr); });
+                    if (m_quit)
+                        return;
+                    seen = m_generation;
+                    job = m_job;
+                    m_active.fetch_add(1, std::memory_order_relaxed);
+                }
+                work(*job);
+                m_active.fetch_sub(1, std::memory_order_release);
+            }
+        }
+
+        std::vector<std::thread> m_threads;
+        std::mutex m_mutex;
+        std::condition_variable m_cv;
+        Job *m_job = nullptr;
+        uint64_t m_generation = 0;
+        bool m_quit = false;
+        std::atomic<int> m_active{0};
+    };
+
+    // divide as linhas [y0, y1] em blocos de 8 linhas e processa em paralelo
+    template <typename RowFn>
+    void un4ParallelRows(int y0, int y1, RowFn &rowFn)
+    {
+        constexpr int kRowsPerChunk = 8;
+        const int rows = y1 - y0 + 1;
+        const int chunks = (rows + kRowsPerChunk - 1) / kRowsPerChunk;
+        const std::function<void(int)> fn = [&](int c)
+        {
+            const int a = y0 + c * kRowsPerChunk;
+            const int b = std::min(y1, a + kRowsPerChunk - 1);
+            for (int y = a; y <= b; ++y)
+                rowFn(y);
+        };
+        Un4RasterPool::get().run(chunks, fn);
+    }
+
+    // regiao de VRAM (em bytes) que pixels (0..width-1, 0..height-1) de um buffer (baseBlock, bw, psm) podem tocar,
+    // seguindo a mesma conta de pagina do enderecamento (PageId); pode passar de 4MB (ver un4Overlap)
+    void un4VramRegion(uint32_t baseBlock, uint32_t bw, uint32_t psm, uint32_t width, uint32_t height, uint32_t &start, uint32_t &end)
+    {
+        uint32_t pageW = 64, pageH = 32;
+        switch (psm)
+        {
+        case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S: pageW = 64; pageH = 64; break;
+        case GS_PSM_T8: pageW = 128; pageH = 64; break;
+        case GS_PSM_T4: pageW = 128; pageH = 128; break;
+        default: break;
+        }
+        const uint32_t pagesPerRow = (bw * 64u) / pageW;
+        const uint32_t rows = std::max<uint32_t>(1u, (height + pageH - 1u) / pageH);
+        const uint32_t cols = std::max<uint32_t>(1u, (width + pageW - 1u) / pageW);
+        uint32_t pages = (rows - 1u) * pagesPerRow + cols;
+        if ((baseBlock & 31u) != 0u)
+            ++pages; // blocos que comecam no meio da pagina avancam para a seguinte
+        start = (baseBlock / 32u) * 8192u;
+        end = start + pages * 8192u;
+    }
+
+    // regioes podem passar do fim da VRAM (4MB) e continuar no comeco
+    constexpr uint32_t kUn4VramBytes = 4u << 20;
+    bool un4Overlap(uint32_t a0, uint32_t a1, uint32_t b0, uint32_t b1)
+    {
+        auto split = [](uint32_t s0, uint32_t s1, uint32_t out[4]) -> int
+        {
+            const uint32_t len = std::min<uint32_t>(s1 - std::min(s1, s0), kUn4VramBytes);
+            s0 %= kUn4VramBytes;
+            if (s0 + len <= kUn4VramBytes)
+            {
+                out[0] = s0; out[1] = s0 + len;
+                return 1;
+            }
+            out[0] = s0; out[1] = kUn4VramBytes; out[2] = 0; out[3] = s0 + len - kUn4VramBytes;
+            return 2;
+        };
+        uint32_t ra[4], rb[4];
+        const int na = split(a0, a1, ra), nb = split(b0, b1, rb);
+        for (int i = 0; i < na; ++i)
+            for (int j = 0; j < nb; ++j)
+                if (ra[2 * i] < rb[2 * j + 1] && rb[2 * j] < ra[2 * i + 1])
+                    return true;
+        return false;
+    }
+}
