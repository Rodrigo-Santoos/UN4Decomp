+void GSCpuBackend::Un4SetupPixelPipe(const GSDrawState &state, Un4PixelPipe &pp)
+{
+    const auto &ctx = state.context;
+    pp.scx0 = ctx.scissor.x0;
+    pp.scx1 = ctx.scissor.x1;
+    pp.scy0 = ctx.scissor.y0;
+    pp.scy1 = ctx.scissor.y1;
+    pp.fge = state.prim.fge;
+    pp.fogR = state.fogR;
+    pp.fogG = state.fogG;
+    pp.fogB = state.fogB;
+    pp.fbp = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    pp.fbw = std::max<u32>(ctx.frame.fbw, 1u);
+    pp.fpsm = ctx.frame.psm;
+    pp.zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    pp.zpsm = ctx.zbuf.psm;
+    pp.test = ctx.test;
+    pp.zTestEnabled = ((ctx.test >> 16) & 1u) != 0u;
+    pp.ztestMethod = pp.zTestEnabled ? static_cast<uint32_t>((ctx.test >> 17) & 3u) : 1u;
+    pp.abe = state.prim.abe;
+    pp.pabe = state.pabe;
+    const uint64_t alphaReg = ctx.alpha;
+    pp.asel = alphaReg & 3;
+    pp.bsel = (alphaReg >> 2) & 3;
+    pp.csel = (alphaReg >> 4) & 3;
+    pp.dsel = (alphaReg >> 6) & 3;
+    pp.fix = static_cast<uint8_t>((alphaReg >> 32) & 0xFF);
+    pp.fba = (ctx.fba & 0x1ull) != 0ull && ctx.frame.psm != GS_PSM_CT24;
+    pp.fbmsk = ctx.frame.fbmsk;
+    pp.zmask = ctx.zbuf.zmask;
+    pp.dateNeedsRead = ((ctx.test >> 14) & 0x1u) != 0u && (pp.fpsm == GS_PSM_CT32 || pp.fpsm == GS_PSM_CT16 || pp.fpsm == GS_PSM_CT16S);
+    pp.fpsm16 = bitsPerPixel(static_cast<uint8_t>(pp.fpsm)) == 16;
+}
