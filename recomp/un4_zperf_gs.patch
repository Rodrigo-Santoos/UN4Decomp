+void GSCpuBackend::Un4SetupSampler(const GSDrawState &state, Un4Sampler &smp)
+{
+    const auto &tex = state.context.tex0;
+    const uint64_t clamp = state.context.clamp;
+    smp.texW = state.textureWidth;
+    smp.texH = state.textureHeight;
+    smp.wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    smp.wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    smp.minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    smp.maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    smp.minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    smp.maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+    smp.tbp0 = tex.tbp0;
+    smp.tbw = tex.tbw;
+    smp.fst = state.prim.fst;
+    smp.linear = state.linearFilter;
+    smp.fastMode = 0;
+    smp.palette = nullptr;
+    if (!m_vram)
+        return;
+    switch (tex.psm)
+    {
+    case GS_PSM_T8: smp.fastMode = 1; break;
+    case GS_PSM_T4: smp.fastMode = 2; break;
+    case GS_PSM_T8H: smp.fastMode = 3; break;
+    case GS_PSM_T4HL: smp.fastMode = 4; break;
+    case GS_PSM_T4HH: smp.fastMode = 5; break;
+    case GS_PSM_CT32: smp.fastMode = 6; break;
+    default: break;
+    }
+    if (smp.fastMode >= 1 && smp.fastMode <= 5)
+        smp.palette = Un4Palette(state);
