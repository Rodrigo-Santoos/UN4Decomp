+bool GSCpuBackend::Un4CanParallelize(const GSDrawState &state, const Un4Sampler &smp, const Un4PixelPipe &pp, int width, int height) const
+{
+    if (width <= 0 || height < 16 || static_cast<int64_t>(width) * height < 4096)
+        return false;
+    if (Un4RasterPool::get().workers() == 0 || !m_vram)
+        return false;
+    // pixels de 4/8 bits no quadro dividem bytes com os vizinhos
+    switch (pp.fpsm)
+    {
+    case GS_PSM_CT32: case GS_PSM_CT24: case GS_PSM_CT16: case GS_PSM_CT16S: break;
+    default: return false;
+    }
+    const bool usesZ = pp.zTestEnabled && (pp.ztestMethod >= 2u || !pp.zmask);
+    if (usesZ)
+    {
+        switch (pp.zpsm)
+        {
+        case GS_PSM_Z32: case GS_PSM_Z24: case GS_PSM_Z16: case GS_PSM_Z16S: break;
+        default: return false;
+        }
+    }
+    if (state.prim.tme)
+    {
+        // o caminho lento de textura usa um cache compartilhado
+        if (smp.fastMode == 0)
+            return false;
+        // textura lida do mesmo lugar onde se desenha: a ordem dos pixels importa, fica numa thread so
+        uint32_t t0, t1, f0, f1, z0, z1;
+        // com REGION_CLAMP/REGION_REPEAT a coordenada pode passar do tamanho da textura (ate 1023)
+        const uint32_t texSpanW = (smp.wrapU >= 2u) ? 1024u : static_cast<uint32_t>(smp.texW);
+        const uint32_t texSpanH = (smp.wrapV >= 2u) ? 1024u : static_cast<uint32_t>(smp.texH);
+        un4VramRegion(state.context.tex0.tbp0, state.context.tex0.tbw, state.context.tex0.psm, texSpanW, texSpanH, t0, t1);
+        const uint32_t fbWidth = pp.fbw * 64u;
+        const uint32_t fbHeight = static_cast<uint32_t>(std::max(pp.scy1, 0) + 1);
+        un4VramRegion(pp.fbp, pp.fbw, pp.fpsm, fbWidth, fbHeight, f0, f1);
+        if (un4Overlap(t0, t1, f0, f1))
+            return false;
+        if (usesZ)
+        {
+            un4VramRegion(pp.zbp, pp.fbw, pp.zpsm, fbWidth, fbHeight, z0, z1);
+            if (un4Overlap(t0, t1, z0, z1))
+                return false;
+        }
+    }
+    return true;
+}
