+        // UN4Decomp: no hardware, os callbacks de stream (sceMpegAddStrCallback) rodam DENTRO de
+        // sceMpegDemuxPss/Ring, antes da funcao retornar. A versao original enfileirava os callbacks
+        // de forma assincrona e eles nunca chegavam a rodar no Naruto UN4 (o audio do filme nunca
+        // enchia e o player esperava para sempre). Aqui eles rodam em sequencia na thread que chamou
+        // o demux, e so depois a thread continua (o valor de retorno ja deve estar em v0).
+        // Os dados de cada callback (sceMpegCbDataStr) ficam no topo da pilha de invocacao.
         void dispatchStreamCallbacksUnlocked(uint8_t *rdram,
                                              R5900Context *ctx,
                                              PS2Runtime *runtime,
                                              const std::vector<MpegStreamCallbackEvent> &events)
         {
-            if (events.empty())
+            if (events.empty() || !rdram || !ctx || !runtime)
+            {
+                return;
+            }
+
+            constexpr size_t kMaxSyncCallbacks = 192u; // 192 * 0x20 = 0x1800 de uma pilha de 0x4000
+            EeScheduler &ee = runtime->eeScheduler();
+            std::vector<GuestInvocation> invocations;
+            std::vector<MpegStreamCallbackEvent> overflow;
+            uint32_t top = 0u;
+            for (const MpegStreamCallbackEvent &event : events)
+            {
+                for (const MpegRegisteredCallback &callback : event.callbacks)
+                {
+                    if (callback.func == 0u || !runtime->hasFunction(callback.func))
+                    {
+                        continue;
+                    }
+                    if (invocations.size() >= kMaxSyncCallbacks)
+                    {
+                        MpegStreamCallbackEvent rest = event;
+                        rest.callbacks = {callback};
+                        overflow.push_back(std::move(rest));
+                        continue;
+                    }
+                    if (top == 0u)
+                    {
+                        top = ee.invocationStackTop();
+                    }
+                    const uint32_t cbDataAddr = top - static_cast<uint32_t>(invocations.size() + 1u) * kMpegCallbackDataSize;
+                    if (!writeMpegCallbackData(rdram, cbDataAddr, event))
+                    {
+                        continue;
+                    }
+                    GuestInvocation invocation{};
+                    invocation.kind = GuestInvocationKind::RpcCallback;
+                    invocation.context = *ctx;
+                    invocation.context.pc = callback.func;
+                    SET_GPR_U32(&invocation.context, 4, event.mpegAddr);
+                    SET_GPR_U32(&invocation.context, 5, cbDataAddr);
+                    SET_GPR_U32(&invocation.context, 6, callback.data);
+                    SET_GPR_U32(&invocation.context, 7, 0u);
+                    SET_GPR_U32(&invocation.context, 31, 0u);
+                    invocations.push_back(std::move(invocation));
+                }
+            }
+
+            if (!overflow.empty())
+            {
+                dispatchStreamCallbacks(rdram, ctx, runtime, overflow);
+            }
+            if (invocations.empty())
             {
                 return;
             }
 
-            dispatchStreamCallbacks(rdram, ctx, runtime, events);
+            const uint32_t dataBottom = top - static_cast<uint32_t>(invocations.size()) * kMpegCallbackDataSize;
+            const uint32_t sp = (dataBottom - 0x40u) & ~0xFu;
+            for (GuestInvocation &invocation : invocations)
+            {
+                SET_GPR_U32(&invocation.context, 29, sp);
+            }
+            ee.invokeCurrentSequence(std::move(invocations));
         }
 
