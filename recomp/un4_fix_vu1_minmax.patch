+namespace
+{
+    // UN4Decomp: no VU do PS2, MAX/MINI comparam os bits do numero como inteiros (sinal e modulo) e
+    // NAO zeram numeros "denormais". Os jogos usam "MAX vfA, vfB, vfB" para copiar cores e outros
+    // valores inteiros (0x80 = 128 como inteiro e um denormal como float). Com a normalizacao, a cor
+    // virava 0 e quase tudo que o VU1 desenhava ficava preto/transparente (titulo e menu do UN4).
+    inline int64_t un4MinMaxKey(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        const int64_t magnitude = static_cast<int64_t>(bits & 0x7FFFFFFFu);
+        return (bits & 0x80000000u) ? -magnitude : magnitude;
+    }
+    inline float un4Max(float a, float b) { return (un4MinMaxKey(a) > un4MinMaxKey(b)) ? a : b; }
+    inline float un4Min(float a, float b) { return (un4MinMaxKey(a) < un4MinMaxKey(b)) ? a : b; }
+}
