+
+void GSCpuBackend::Un4LoadState(const uint8_t *&p, size_t &left)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    un4gsdump::get(p, left, &m_clut, sizeof(m_clut));
+    un4gsdump::get(p, left, &m_clutCbp, sizeof(m_clutCbp));
+    un4gsdump::get(p, left, &m_transfer, sizeof(m_transfer));
+    un4gsdump::get(p, left, &m_transferState, sizeof(m_transferState));
+    m_texturePageCache.Invalidate();
+}
