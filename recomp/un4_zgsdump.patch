+namespace
+{
+    void un4PutPrivRegs(std::vector<uint8_t> &b, const GSRegisters *r, uint64_t tick)
+    {
+        const uint64_t v[8] = {r->pmode, r->smode2, r->dispfb1, r->display1, r->dispfb2, r->display2, r->bgcolor, tick};
+        un4gsdump::putv(b, un4gsdump::kVsync);
