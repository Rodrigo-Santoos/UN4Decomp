+// Chamado com m_stateMutex travado, no comeco de cada entrada publica que muda o GS.
+void GS::un4DumpHook()
+{
+    un4gsdump::State &d = un4gsdump::st();
+    if (!d.active && !d.armed && d.requests.load(std::memory_order_relaxed) == 0 &&
+        (d.envParsed && d.autoTicks.empty()))
+        return;
+    if (!m_privRegs || !m_localMemoryStorage)
+        return;
+    un4gsdump::parseEnvOnce();
+    const uint64_t tick = m_privRegs->vsyncTick.load(std::memory_order_relaxed);
+
+    if (!d.active)
+    {
+        if (!d.armed)
+        {
+            bool want = false;
+            if (d.requests.load(std::memory_order_acquire) > 0)
+            {
+                d.requests.fetch_sub(1, std::memory_order_acq_rel);
+                want = true;
+            }
+            for (size_t i = 0; i < d.autoTicks.size(); ++i)
+            {
+                if (tick >= d.autoTicks[i])
+                {
+                    d.autoTicks.erase(d.autoTicks.begin() + static_cast<std::ptrdiff_t>(i));
+                    want = true;
+                    break;
+                }
+            }
+            if (!want || d.written >= d.maxDumps)
+                return;
+            d.armed = true;
+            d.startTick = tick;
+            return;
+        }
+        if (tick == d.startTick)
+            return;
+        // comeco da gravacao: estado + VRAM inteira, antes do primeiro comando deste vblank
+        d.active = true;
+        d.armed = false;
+        d.startTick = tick;
+        d.lastTick = tick;
+        d.buf.clear();
+        d.buf.reserve(32u << 20);
+        un4gsdump::put(d.buf, "UN4GSDMP", 8);
+        un4gsdump::putv(d.buf, un4gsdump::kVersion);
+        std::vector<uint8_t> state;
+        un4SaveState(state);
+        un4gsdump::putv(d.buf, static_cast<uint32_t>(state.size()));
+        un4gsdump::put(d.buf, state.data(), state.size());
+        un4gsdump::putv(d.buf, m_localMemorySize);
+        un4gsdump::put(d.buf, m_localMemoryStorage, m_localMemorySize);
+        un4PutPrivRegs(d.buf, m_privRegs, tick);
+        std::cerr << "[un4gsdump] gravando a partir do vblank " << tick << " (" << d.vblanks << " vblanks)" << std::endl;
+        return;
+    }
+
+    if (tick == d.lastTick)
+        return;
+    d.lastTick = tick;
+    un4PutPrivRegs(d.buf, m_privRegs, tick);
+    if (tick - d.startTick < d.vblanks)
+        return;
+
+    un4gsdump::putv(d.buf, un4gsdump::kEnd);
+    un4gsdump::putv(d.buf, 0u);
+    char name[64];
+    std::snprintf(name, sizeof(name), "/gsdump_%06llu.bin", static_cast<unsigned long long>(d.startTick));
+    const std::string path = un4gsdump::dir() + name;
+    if (FILE *f = std::fopen(path.c_str(), "wb"))
+    {
+        std::fwrite(d.buf.data(), 1, d.buf.size(), f);
+        std::fclose(f);
+        ++d.written;
+        std::cerr << "[un4gsdump] salvo " << path << " (" << (d.buf.size() >> 10) << " KB)" << std::endl;
+    }
+    else
+    {
+        std::cerr << "[un4gsdump] falhou ao criar " << path << std::endl;
+    }
+    d.active = false;
+    d.buf.clear();
+    d.buf.shrink_to_fit();
+}
