diff --git a/ps2xRuntime/include/runtime/gs/un4_gsdump.h b/ps2xRuntime/include/runtime/gs/un4_gsdump.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/un4_gsdump.h
@@ -0,0 +1,121 @@
+#pragma once
+// UN4Decomp: gravacao de quadros do GS ("gsdump") para reproduzir fora do jogo.
+// Grava o estado do GS + a VRAM inteira no comeco de um vblank e depois tudo o que chega no GS
+// (pacotes GIF, uploads, registradores) durante alguns vblanks. O programa un4_gsreplay le o arquivo,
+// refaz os desenhos com o mesmo backend e salva a imagem de cada vblank.
+// Pedido: tecla F9 na janela do jogo, ou automatico (un4prof), ou UN4_GSDUMP_AT=vblank1,vblank2,...
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace un4gsdump
+{
+    enum : uint32_t
+    {
+        kGif = 1u,
+        kPacked = 2u,
+        kUpload = 3u,
+        kReg = 4u,
+        kVsync = 5u,
+        kClear = 6u,
+        kWriteVram = 7u,
+        kEnd = 0xFFFFFFFFu,
+    };
+
+    constexpr uint32_t kVersion = 1u;
+
+    struct State
+    {
+        std::atomic<int> requests{0};
+        std::atomic<uint32_t> requestReason{0};
+        bool armed = false;
+        bool active = false;
+        uint64_t startTick = 0;
+        uint64_t lastTick = 0;
+        uint32_t vblanks = 4u;
+        uint32_t written = 0u;
+        uint32_t maxDumps = 12u;
+        std::vector<uint8_t> buf;
+        std::vector<uint64_t> autoTicks;
+        bool envParsed = false;
+    };
+
+    inline State &st()
+    {
+        static State s;
+        return s;
+    }
+
+    // reason: 0 = tecla F9, outros = automatico (modo do jogo)
+    inline void request(uint32_t reason = 0u)
+    {
+        State &s = st();
+        if (s.written >= s.maxDumps)
+            return;
+        s.requestReason.store(reason, std::memory_order_relaxed);
+        s.requests.fetch_add(1, std::memory_order_release);
+    }
+
+    inline void put(std::vector<uint8_t> &b, const void *p, size_t n)
+    {
+        const uint8_t *q = static_cast<const uint8_t *>(p);
+        b.insert(b.end(), q, q + n);
+    }
+
+    template <class T>
+    inline void putv(std::vector<uint8_t> &b, const T &v)
+    {
+        put(b, &v, sizeof(T));
+    }
+
+    inline void get(const uint8_t *&p, size_t &left, void *dst, size_t n)
+    {
+        if (left < n)
+        {
+            std::memset(dst, 0, n);
+            p += left;
+            left = 0;
+            return;
+        }
+        std::memcpy(dst, p, n);
+        p += n;
+        left -= n;
+    }
+
+    inline std::string dir()
+    {
+        const char *d = std::getenv("UN4_GSDUMP_DIR");
+        return (d && *d) ? std::string(d) : std::string(".");
+    }
+
+    inline void parseEnvOnce()
+    {
+        State &s = st();
+        if (s.envParsed)
+            return;
+        s.envParsed = true;
+        if (const char *v = std::getenv("UN4_GSDUMP_VBLANKS"))
+        {
+            const long n = std::strtol(v, nullptr, 10);
+            if (n > 0 && n < 64)
+                s.vblanks = static_cast<uint32_t>(n);
+        }
+        if (const char *v = std::getenv("UN4_GSDUMP_AT"))
+        {
+            const char *p = v;
+            while (*p)
+            {
+                char *end = nullptr;
+                const unsigned long long t = std::strtoull(p, &end, 10);
+                if (end == p)
+                    break;
+                s.autoTicks.push_back(static_cast<uint64_t>(t));
+                p = (*end == ',') ? end + 1 : end;
+            }
+        }
+    }
+}
