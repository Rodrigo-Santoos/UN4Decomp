+void GS::un4SaveState(std::vector<uint8_t> &out) const
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+#define UN4_GSD_PUT(f) static_assert(std::is_trivially_copyable_v<decltype(f)>); un4gsdump::putv(out, f);
+    UN4_GSD_FIELDS(UN4_GSD_PUT)
+#undef UN4_GSD_PUT
+    if (const auto *cpu = dynamic_cast<const GSCpuBackend *>(m_backend.get()))
+        cpu->Un4SaveState(out);
+}
+
+void GS::un4LoadState(const uint8_t *data, size_t size)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    const uint8_t *p = data;
+    size_t left = size;
+#define UN4_GSD_GET(f) un4gsdump::get(p, left, &f, sizeof(f));
+    UN4_GSD_FIELDS(UN4_GSD_GET)
+#undef UN4_GSD_GET
+    if (auto *cpu = dynamic_cast<GSCpuBackend *>(m_backend.get()))
+        cpu->Un4LoadState(p, left);
+}
