+                                   "std::memcpy(&ctx->f[{1}], &tmp, sizeof(tmp)); }}",
+                                   fs, fd);
             case COP1_S_RSQRT:
                 // RSQRT.S fd, fs, ft computes fs / sqrt(ft), not 1 / sqrt(fs).
                 return fmt::format("ctx->f[{}] = FPU_RSQRT_S(ctx->f[{}], ctx->f[{}]);", fd, fs, ft);
