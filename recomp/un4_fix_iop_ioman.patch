+        // UN4Decomp: arquivo do disco para o ioman. Procura na imagem ISO (ou no diretorio virtual).
+        bool un4LookupFile(const std::string &path, uint32_t &lsnOut, uint32_t &sizeOut)
+        {
+            bool directory = false;
+            if (imageLookup(path, lsnOut, sizeOut, directory))
