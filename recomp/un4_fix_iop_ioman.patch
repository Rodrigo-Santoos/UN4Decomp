+
+    // UN4Decomp: open/close/read/lseek de arquivos "cdrom0:" (ioman 4/5/6/8), lidos da imagem do disco.
+    // O SNDBASE.IRX do UN4 carrega os bancos de som (DATA\SNDDATA.BIN) assim. Antes essas chamadas nao
+    // existiam: o read devolvia 0 e o SNDBASE repetia a leitura para sempre ("file read error!"), e o
+    // jogo ficava preso numa tela preta esperando o som carregar.
+    bool IopIoman::un4DispatchCdFile(uint16_t ordinal, IopCpuState &cpu)
+    {
+        constexpr uint32_t kErrNoEnt = static_cast<uint32_t>(-2);
+        constexpr uint32_t kErrIo = static_cast<uint32_t>(-5);
+        constexpr uint32_t kErrInval = static_cast<uint32_t>(-22);
+        const uint32_t a0 = cpu.gpr[4];
+        const uint32_t a1 = cpu.gpr[5];
+        const uint32_t a2 = cpu.gpr[6];
+        const auto fileFor = [&](uint32_t fd) -> CdFile *
+        {
+            return (fd < m_cdFiles.size() && m_cdFiles[fd].used) ? &m_cdFiles[fd] : nullptr;
+        };
+
+        switch (ordinal)
+        {
+        case 4: // open(name, mode)
+        {
+            const std::string name = m_memory.readString(a0, 256u);
+            std::string device = name.substr(0u, name.find(':'));
+            std::transform(device.begin(), device.end(), device.begin(),
+                           [](unsigned char ch) { return static_cast<char>(std::tolower(ch)); });
+            if (name.find(':') == std::string::npos || (device != "cdrom0" && device != "cdrom"))
+                return false;
+            uint32_t lsn = 0u, size = 0u;
+            if ((a1 & 3u) != 1u || !m_cdvd.un4LookupFile(name, lsn, size))
+            {
+                std::fprintf(stderr, "[un4ioman] open %s modo=0x%x -> nao encontrado\n", name.c_str(), a1);
+                cpu.gpr[2] = kErrNoEnt;
+                return true;
+            }
+            size_t fd = 0u;
+            while (fd < m_cdFiles.size() && m_cdFiles[fd].used)
+                ++fd;
+            if (fd == m_cdFiles.size())
+                m_cdFiles.emplace_back();
+            m_cdFiles[fd] = CdFile{true, lsn, size, 0u, name};
+            std::fprintf(stderr, "[un4ioman] open %s -> fd %zu (lsn=0x%x tamanho=0x%x)\n", name.c_str(), fd, lsn, size);
+            cpu.gpr[2] = static_cast<uint32_t>(fd);
+            return true;
+        }
+        case 5: // close(fd)
+        {
+            CdFile *file = fileFor(a0);
+            if (!file)
+                return false;
+            file->used = false;
+            // o SNDBASE so aceita o close quando ele devolve o proprio fd (no PS2 o primeiro fd e 0)
+            cpu.gpr[2] = a0;
+            return true;
+        }
+        case 6: // read(fd, buffer, size)
+        {
+            CdFile *file = fileFor(a0);
+            if (!file)
+                return false;
+            const uint64_t left = file->position < file->size ? file->size - file->position : 0u;
+            const size_t count = static_cast<size_t>(std::min<uint64_t>(a2, left));
+            std::vector<uint8_t> bytes(count);
+            if (!m_cdvd.un4ReadBytes(file->lsn, file->position, bytes.data(), count) ||
+                (count != 0u && !m_memory.writeRam(a1, bytes.data(), count)))
+            {
+                std::fprintf(stderr, "[un4ioman] read FALHOU %s pos=0x%llx tamanho=0x%zx destino=0x%x\n", file->path.c_str(),
+                             static_cast<unsigned long long>(file->position), count, a1);
+                cpu.gpr[2] = kErrIo;
+                return true;
+            }
+            file->position += count;
+            cpu.gpr[2] = static_cast<uint32_t>(count);
+            return true;
+        }
+        case 8: // lseek(fd, offset, whence)
+        {
+            CdFile *file = fileFor(a0);
+            if (!file)
+                return false;
+            int64_t base = 0;
+            if (a2 == 1u)
+                base = static_cast<int64_t>(file->position);
+            else if (a2 == 2u)
+                base = static_cast<int64_t>(file->size);
+            else if (a2 != 0u)
+            {
+                cpu.gpr[2] = kErrInval;
+                return true;
+            }
+            const int64_t target = base + static_cast<int32_t>(a1);
+            if (target < 0)
+            {
+                cpu.gpr[2] = kErrInval;
+                return true;
+            }
+            file->position = static_cast<uint64_t>(target);
+            cpu.gpr[2] = static_cast<uint32_t>(target);
+            return true;
+        }
+        default:
+            return false;
+        }
     }
 
