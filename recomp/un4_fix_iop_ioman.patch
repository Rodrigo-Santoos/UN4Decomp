+            const uint64_t start = static_cast<uint64_t>(lsn) * kSectorSize + offset;
+            const std::string imagePath = host.hostPath(HostPathKind::CdImage);
+            if (!imagePath.empty())
+            {
+                if (imageHandle == 0u)
+                    imageHandle = host.openHostFile(imagePath);
+                size_t bytesRead = 0u;
+                if (imageHandle != 0u && host.readHostFile(imageHandle, start, dst, size, bytesRead) && bytesRead == size)
+                    return true;
+            }
+            if (!buildVirtualIso())
+                return false;
+            std::array<uint8_t, kSectorSize> sector{};
+            uint64_t position = start;
+            size_t done = 0u;
+            while (done < size)
+            {
+                const uint32_t sectorLsn = static_cast<uint32_t>(position / kSectorSize);
+                const size_t within = static_cast<size_t>(position % kSectorSize);
+                const size_t count = std::min<size_t>(size - done, kSectorSize - within);
+                if (!readVirtualSector(sectorLsn, sector.data()))
+                    return false;
+                std::memcpy(dst + done, sector.data() + within, count);
+                done += count;
+                position += count;
+            }
+            return true;
+        }
