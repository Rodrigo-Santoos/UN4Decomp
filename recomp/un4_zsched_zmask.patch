+// UN4Decomp: a thread atual desligou as interrupcoes (DI / DIntr: bit EIE do Status do COP0 zerado)?
+// No PS2 nenhuma interrupcao chega enquanto isso: nada de handler de vblank/alarme/DMA e nenhuma troca de thread
+// causada por eles. O jogo usa DIntr/EIntr para proteger o gerenciador de memoria dele; antes as interrupcoes
+// e as trocas de thread aconteciam no meio dessas partes protegidas e a lista de memoria livre do jogo se
+// corrompia (a carga travava em 14% com uma thread dando voltas para sempre na lista).
+static bool un4InterruptsMasked(const GuestThread *thread)
+{
+    if (!thread)
+        return false;
+    const R5900Context &context = const_cast<GuestThread *>(thread)->activeContext();
+    return (context.cop0_status & 0x10000u) == 0u;
+}
+
 void EeScheduler::run()
 {
     assertExecutor();
