     std::string CodeGenerator::translateVU_VISWR(const Instruction &inst)
     {
-        return fmt::format("{{ uint32_t addr = (uint32_t)(ctx->vi[{}] << 2) & 0x3FFC; WRITE32(addr, (uint32_t)ctx->vi[{}]); }}", inst.rd, inst.rt); // VISWR.<f> vit, (vis)
+        // VISWR.<dest> vit, (vis): grava VI[it] (16 bits, zero-extendido) em cada campo de <dest> do qword VI[is]
+        const uint8_t dest = inst.vectorInfo.vectorField;
+        std::string body = fmt::format("{{ uint8_t *un4p = {}; const uint32_t un4v = static_cast<uint32_t>(ctx->vi[{}]); ", un4Vu0QwordAddr(inst.rd), inst.rt & 0xF);
+        if (dest & 0x8) body += "std::memcpy(un4p + 0, &un4v, 4); ";
+        if (dest & 0x4) body += "std::memcpy(un4p + 4, &un4v, 4); ";
+        if (dest & 0x2) body += "std::memcpy(un4p + 8, &un4v, 4); ";
+        if (dest & 0x1) body += "std::memcpy(un4p + 12, &un4v, 4); ";
+        body += "}";
+        return body;
     }
 
