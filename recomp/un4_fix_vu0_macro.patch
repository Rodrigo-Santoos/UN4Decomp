 namespace ps2recomp
 {
+
+    // UN4Decomp: helpers para as instrucoes inteiras/de memoria do VU0 em modo macro.
+    // - vi0 vale sempre 0 no PS2: escrita em vi0 e descartada (antes o VSQI incrementava vi0).
+    // - VLQI/VSQI/VLQD/VSQD/VILWR/VISWR usam a memoria de dados do VU0 (4KB, endereco em qwords, da a volta),
+    //   e nao a RDRAM baixa.
+    namespace
+    {
+        std::string un4ViWrite(uint8_t vi, const std::string &expr)
+        {
+            if ((vi & 0xF) == 0)
+                return std::string("/* escrita em vi0 ignorada */");
+            return fmt::format("ctx->vi[{}] = static_cast<uint16_t>({});", vi & 0xF, expr);
+        }
+
+        std::string un4VfMask(uint8_t dest)
+        {
+            return fmt::format("_mm_castsi128_ps(_mm_set_epi32({}, {}, {}, {}))",
+                               (dest & 0x1) ? -1 : 0, (dest & 0x2) ? -1 : 0,
+                               (dest & 0x4) ? -1 : 0, (dest & 0x8) ? -1 : 0);
+        }
+
+        std::string un4Vu0QwordAddr(uint8_t vi)
+        {
+            return fmt::format("(runtime->memory().getVU0Data() + ((static_cast<uint32_t>(ctx->vi[{}]) & 0xFFu) << 4))", vi & 0xF);
+        }
+
+        std::string un4Vu0Load(uint8_t ft, uint8_t vis, uint8_t dest)
+        {
+            if (ft == 0)
+                return std::string("/* load em vf0 ignorado */");
+            return fmt::format("{{ const uint8_t *un4p = {}; ctx->vu0_vf[{}] = _mm_blendv_ps(ctx->vu0_vf[{}], _mm_loadu_ps(reinterpret_cast<const float *>(un4p)), {}); }}",
+                               un4Vu0QwordAddr(vis), ft, ft, un4VfMask(dest));
+        }
+
+        std::string un4Vu0Store(uint8_t fs, uint8_t vit, uint8_t dest)
+        {
+            return fmt::format("{{ uint8_t *un4p = {}; __m128 un4old = _mm_loadu_ps(reinterpret_cast<const float *>(un4p)); _mm_storeu_ps(reinterpret_cast<float *>(un4p), _mm_blendv_ps(un4old, ctx->vu0_vf[{}], {})); }}",
+                               un4Vu0QwordAddr(vit), fs, un4VfMask(dest));
+        }
+
+        uint32_t un4FieldOffset(uint8_t dest)
+        {
+            if (dest & 0x8) return 0u;  // x
+            if (dest & 0x4) return 4u;  // y
+            if (dest & 0x2) return 8u;  // z
+            return 12u;                 // w
+        }
+    }
+
