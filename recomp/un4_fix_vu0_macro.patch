     std::string CodeGenerator::translateVU_VILWR(const Instruction &inst)
     {
-        return fmt::format("{{ uint32_t addr = (uint32_t)(ctx->vi[{}] << 2) & 0x3FFC; ctx->vi[{}] = static_cast<uint16_t>(READ32(addr)); }}", inst.rd, inst.rt); // VILWR.<f> vit, (vis)
+        // VILWR.<f> vit, (vis): le a palavra do campo <f> do qword VI[is] da memoria do VU0
+        const uint32_t off = un4FieldOffset(inst.vectorInfo.vectorField);
+        return fmt::format("{{ uint32_t un4w; std::memcpy(&un4w, {} + {}u, sizeof(un4w)); {} }}",
