+#pragma once
+// UN4Decomp (diagnostico): de onde vieram os dados que o VIF1 recebeu numa cadeia de DMA.
+// O construtor da cadeia (ps2_memory.cpp) junta tudo num buffer so; aqui fica, para cada pedaco do
+// buffer, o endereco original no EE e a tag de DMA que o trouxe.
+#include <cstdint>
+#include <vector>
+
+namespace un4dma
+{
+    struct Seg
+    {
+        uint32_t bufOff = 0;  // posicao no buffer da cadeia
+        uint32_t bytes = 0;   // tamanho do pedaco
+        uint32_t guest = 0;   // endereco no EE (0x7000xxxx = scratchpad)
+        uint32_t tagAddr = 0; // endereco da tag de DMA
+        uint64_t tag = 0;     // tag (64 bits de baixo)
+        bool tagUpper = false; // true: os 8 bytes de cima da tag (TTE), false: dados
+    };
+
+    void registerSegs(const uint8_t *key, std::vector<Seg> &&segs);
+    void forget(const uint8_t *key);
+    // Endereco no EE do byte 'off' do buffer 'key'. Falso se o buffer nao veio de uma cadeia registrada.
+    bool lookup(const uint8_t *key, uint32_t off, Seg &out);
+    // Lista (no stderr) as tags da cadeia, no maximo 'maxLines' linhas.
+    void dumpChain(const uint8_t *key, int maxLines);
+}
