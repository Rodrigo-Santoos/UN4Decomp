+    namespace
+    {
+        std::mutex &registryMutex()
+        {
+            static std::mutex m;
+            return m;
+        }
+        std::unordered_map<const uint8_t *, std::vector<Seg>> &registry()
+        {
+            static std::unordered_map<const uint8_t *, std::vector<Seg>> r;
+            return r;
+        }
+    }
+
+    void registerSegs(const uint8_t *key, std::vector<Seg> &&segs)
+    {
+        std::lock_guard<std::mutex> lock(registryMutex());
+        registry()[key] = std::move(segs);
+    }
+
+    void forget(const uint8_t *key)
+    {
+        std::lock_guard<std::mutex> lock(registryMutex());
+        registry().erase(key);
+    }
+
+    bool lookup(const uint8_t *key, uint32_t off, Seg &out)
+    {
+        std::lock_guard<std::mutex> lock(registryMutex());
+        auto it = registry().find(key);
+        if (it == registry().end())
+            return false;
+        for (const Seg &s : it->second)
+        {
+            if (off >= s.bufOff && off < s.bufOff + s.bytes)
+            {
+                out = s;
+                return true;
+            }
+        }
+        return false;
+    }
+
+    void dumpChain(const uint8_t *key, int maxLines)
+    {
+        std::lock_guard<std::mutex> lock(registryMutex());
+        auto it = registry().find(key);
+        if (it == registry().end())
+        {
+            std::cerr << "[un4dma]   (cadeia nao registrada)" << std::endl;
+            return;
+        }
+        int lines = 0;
+        for (const Seg &s : it->second)
+        {
+            if (s.tagUpper)
+                continue;
+            if (++lines > maxLines)
+            {
+                std::cerr << "[un4dma]   ... (" << it->second.size() << " pedacos no total)" << std::endl;
+                break;
+            }
+            std::cerr << "[un4dma]   buf+0x" << std::hex << s.bufOff << " tag@0x" << s.tagAddr << " tag=0x" << s.tag
+                      << " id=" << ((s.tag >> 28) & 7u) << " qwc=0x" << (s.tag & 0xFFFFu) << " dados@0x" << s.guest
+                      << " bytes=0x" << s.bytes << std::dec << std::endl;
+        }
+    }
+}
