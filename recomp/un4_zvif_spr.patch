+    // UN4Decomp (diagnostico): o VU1 da luta le a matriz da camera em VU1[0..3] (LQ 0..3(vi0)). Quando ela chega
+    // com lixo (expoente 255 = 0x7fffffff etc.) registra de onde o DMA trouxe esses dados e grava a RAM do EE.
+    bool un4WordInsane(uint32_t w)
+    {
+        return (w & 0x7F800000u) == 0x7F800000u;
+    }
+
+    void un4DumpEeRam(const uint8_t *rdram, const uint8_t *spr, const uint8_t *vu1Data, const uint8_t *vu1Code, uint64_t n)
+    {
+        const char *dir = std::getenv("UN4_GSDUMP_DIR");
+        std::string path = std::string(dir && *dir ? dir : ".") + "/eeram_" + std::to_string(n) + ".bin";
+        std::FILE *f = std::fopen(path.c_str(), "wb");
+        if (!f)
+        {
+            std::cerr << "[un4cam] nao consegui criar " << path << std::endl;
+            return;
+        }
+        static const uint8_t zeros[16384] = {};
+        std::fwrite("UN4RAM01", 1, 8, f);
+        std::fwrite(rdram, 1, PS2_RAM_SIZE, f);
+        std::fwrite(spr ? spr : zeros, 1, PS2_SCRATCHPAD_SIZE, f);
+        std::fwrite(vu1Data ? vu1Data : zeros, 1, 16384, f);
+        std::fwrite(vu1Code ? vu1Code : zeros, 1, 16384, f);
+        std::fclose(f);
+        std::cerr << "[un4cam] RAM do EE gravada em " << path << std::endl;
+    }
+
+    void un4CheckCameraUpload(const uint8_t *data, uint32_t pos, uint32_t sizeBytes, uint32_t cmd, uint32_t vuAddr,
+                              uint32_t writeCount, const VIFRegisters &regs, const uint8_t *rdram, const uint8_t *spr,
+                              const uint8_t *vu1Data, const uint8_t *vu1Code)
+    {
+        static uint64_t s_count = 0;
+        static uint32_t s_insaneLogged = 0;
+        static bool s_lastInsane = false;
+        static bool s_dumped = false;
+        ++s_count;
+        const uint8_t opcode = static_cast<uint8_t>((cmd >> 24) & 0x7Fu);
+        const bool v4_32 = (opcode & 0x6Fu) == 0x6Cu;
+        uint32_t words[16] = {};
+        const uint32_t avail = (sizeBytes > pos) ? (sizeBytes - pos) : 0u;
+        const uint32_t copy = std::min<uint32_t>(avail, v4_32 ? std::min<uint32_t>(writeCount, 4u) * 16u : 16u);
+        std::memcpy(words, data + pos, copy);
+        bool insane = false;
+        if (v4_32)
+            for (uint32_t i = 0; i < copy / 4u; ++i)
+                insane = insane || un4WordInsane(words[i]);
+
+        const bool transition = insane != s_lastInsane;
+        const bool log = s_count <= 6u || transition || (insane && s_insaneLogged < 8u) || (s_count % 3000u) == 0u;
+        s_lastInsane = insane;
+        if (!log)
+            return;
+        if (insane)
+            ++s_insaneLogged;
+
+        const uint8_t *src = data + pos;
+        uint32_t guest = 0u;
+        const char *kind = "?";
+        un4dma::Seg seg;
+        bool haveSeg = false;
+        if (rdram && src >= rdram && src < rdram + PS2_RAM_SIZE)
+        {
+            guest = static_cast<uint32_t>(src - rdram);
+            kind = "RAM";
+        }
+        else if (spr && src >= spr && src < spr + PS2_SCRATCHPAD_SIZE)
+        {
+            guest = PS2_SCRATCHPAD_BASE + static_cast<uint32_t>(src - spr);
+            kind = "SPR";
+        }
+        else if (un4dma::lookup(data, pos, seg))
+        {
+            guest = seg.guest + (pos - seg.bufOff);
+            kind = seg.tagUpper ? "tag(TTE)" : "cadeia";
+            haveSeg = true;
+        }
+
+        std::cerr << "[un4cam] #" << s_count << (insane ? " LIXO" : " ok") << " cmd=0x" << std::hex << cmd << " vu=0x" << vuAddr
+                  << " tops=0x" << regs.tops << " base=0x" << regs.base << " ofst=0x" << regs.ofst << " cycle=0x" << regs.cycle
+                  << " mode=" << regs.mode << " origem=" << kind << ":0x" << guest;
+        if (haveSeg)
+            std::cerr << " (tag@0x" << seg.tagAddr << " tag=0x" << seg.tag << ")";
+        std::cerr << " dados:";
+        for (uint32_t i = 0; i < copy / 4u; ++i)
+            std::cerr << ((i % 4u) == 0u ? " | " : " ") << words[i];
+        std::cerr << std::dec << std::endl;
+
+        if (insane && !s_dumped)
+        {
+            s_dumped = true;
+            std::cerr << "[un4cam] cadeia de DMA que trouxe a matriz com lixo:" << std::endl;
+            un4dma::dumpChain(data, 160);
+            un4DumpEeRam(rdram, spr, vu1Data, vu1Code, s_count);
+        }
+    }
+}
