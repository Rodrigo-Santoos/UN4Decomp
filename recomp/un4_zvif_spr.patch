+    // UN4Decomp: no DMAC o bit 31 de MADR/TADR (e o bit 63 da tag, que e o bit 31 do campo ADDR) escolhe a
+    // scratchpad (SPR): o endereco vira um deslocamento dentro dos 16KB dela. O runtime tratava 0x8000xxxx
+    // como KSEG0 (RAM baixa), lendo a memoria errada.
+    uint32_t un4DmaSprAddress(uint32_t addr, uint32_t channelBase, const char *what)
+    {
+        if ((addr & 0x80000000u) == 0u || ps2IsScratchpadAddress(addr))
+            return addr;
+        static std::atomic<uint32_t> s_logged{0};
+        if (s_logged.fetch_add(1, std::memory_order_relaxed) < 12u)
+            std::cerr << "[un4dma] canal 0x" << std::hex << channelBase << " " << what << " com bit SPR: 0x" << addr
+                      << " -> scratchpad+0x" << (addr & 0x3FF0u) << std::dec << std::endl;
+        return PS2_SCRATCHPAD_BASE | (addr & 0x3FF0u);
+    }
+
+    uint32_t un4DmaRegisterAddress(uint32_t addr)
+    {
+        // Ao devolver MADR/TADR para o jogo, a scratchpad volta a ser indicada pelo bit 31.
+        if (addr >= PS2_SCRATCHPAD_BASE && addr < PS2_SCRATCHPAD_BASE + PS2_SCRATCHPAD_SIZE)
+            return 0x80000000u | (addr - PS2_SCRATCHPAD_BASE);
+        return addr;
+    }
+}
