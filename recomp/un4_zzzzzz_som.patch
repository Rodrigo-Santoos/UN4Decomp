+// UN4Decomp: saida de som. A CRI ADX (musica e vozes) roda no IOP e entrega o som ja decodificado ao SPU2 por
+// sceSdBlockTrans: um buffer circular de PCM 16 bits, 48 kHz, em blocos de 512 bytes (256 amostras) do canal
+// esquerdo seguidos de 512 bytes do direito. Cada vez que o "SPU2" termina de tocar uma metade do buffer, ela e
+// copiada para esta fila, e o runtime (thread de audio do PC) puxa daqui com un4AudioPull.
+#include <deque>
+#include <mutex>
+namespace
+{
+    std::mutex g_un4AudioMutex;
+    std::deque<int16_t> g_un4AudioFifo; // amostras intercaladas E,D
+    bool g_un4AudioPrimed = false;
+    constexpr size_t kUn4AudioMaxSamples = 14400u * 2u; // 0,3 segundo (acima disso descarta o mais antigo)
+    constexpr size_t kUn4AudioPrimeSamples = 3072u * 2u; // ~64 ms guardados antes de comecar a tocar
+
+    void un4AudioPush(const int16_t *interleaved, size_t frames)
+    {
+        std::lock_guard<std::mutex> lock(g_un4AudioMutex);
+        g_un4AudioFifo.insert(g_un4AudioFifo.end(), interleaved, interleaved + frames * 2u);
+        while (g_un4AudioFifo.size() > kUn4AudioMaxSamples)
+            g_un4AudioFifo.pop_front();
+    }
+}
+
+// Preenche 'out' com 'frames' quadros estereo (silencio quando falta som). Chamada pela thread de audio.
+// O jogo nem sempre roda a 60 quadros por segundo exatos (no menu fica em ~57), entao o som chega um pouco mais
+// devagar do que a placa consome. Em vez de deixar buracos (estalos), a leitura acompanha o ritmo de chegada:
+// quanto mais vazia a fila, mais devagar ela e lida (interpolando), ate o limite de 60% da velocidade.
+void un4AudioPull(int16_t *out, size_t frames)
+{
+    std::lock_guard<std::mutex> lock(g_un4AudioMutex);
+    static double pos = 0.0;    // posicao fracionaria dentro da fila (em quadros)
+    static double ratio = 1.0;  // quadros da fila consumidos por quadro tocado
+    constexpr double kTargetFrames = 2400.0; // ~50 ms guardados
+    size_t available = g_un4AudioFifo.size() / 2u;
+    if (!g_un4AudioPrimed && available >= kUn4AudioPrimeSamples / 2u)
+    {
+        g_un4AudioPrimed = true;
+        pos = 0.0;
+    }
+    size_t done = 0;
+    if (g_un4AudioPrimed)
+    {
+        double wantedRatio = static_cast<double>(available) / kTargetFrames;
+        wantedRatio = std::min(1.03, std::max(0.6, wantedRatio));
+        ratio = ratio * 0.9 + wantedRatio * 0.1;
+        for (; done < frames; ++done)
+        {
+            const size_t idx = static_cast<size_t>(pos);
+            if (idx + 1u >= available)
+                break;
+            const double frac = pos - static_cast<double>(idx);
+            for (size_t c = 0; c < 2u; ++c)
+            {
+                const double a = g_un4AudioFifo[idx * 2u + c];
+                const double b = g_un4AudioFifo[(idx + 1u) * 2u + c];
+                out[done * 2u + c] = static_cast<int16_t>(a + (b - a) * frac);
+            }
+            pos += ratio;
+        }
+        const size_t consumed = std::min(static_cast<size_t>(pos), available);
+        g_un4AudioFifo.erase(g_un4AudioFifo.begin(), g_un4AudioFifo.begin() + static_cast<std::ptrdiff_t>(consumed * 2u));
+        pos -= static_cast<double>(consumed);
+        if (done < frames)
+        {
+            g_un4AudioPrimed = false; // acabou o som: junta um pouco de novo antes de voltar a tocar
+            // termina em rampa para nao estalar
+            const size_t ramp = std::min<size_t>(done, 64u);
+            for (size_t k = 0; k < ramp; ++k)
+            {
+                const double g = static_cast<double>(ramp - 1u - k) / static_cast<double>(ramp);
+                out[(done - ramp + k) * 2u] = static_cast<int16_t>(out[(done - ramp + k) * 2u] * g);
+                out[(done - ramp + k) * 2u + 1u] = static_cast<int16_t>(out[(done - ramp + k) * 2u + 1u] * g);
+            }
+        }
+    }
+    for (size_t k = done * 2u; k < frames * 2u; ++k)
+        out[k] = 0;
+}
