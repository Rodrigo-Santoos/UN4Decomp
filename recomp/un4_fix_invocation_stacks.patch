 {
+    // UN4Decomp: pilhas de invocacao (callbacks/interrupcoes) de threads que ja terminaram, para reutilizar.
+    // Antes cada thread nova ganhava pilhas de 16KB que nunca eram devolvidas; o UN4 cria e termina muitas
+    // threads ao carregar uma luta e o espaco acabava ("EE invocation stack space exhausted").
+    std::vector<uint32_t> &un4FreeInvocationStacks()
+    {
+        static std::vector<uint32_t> s_free;
+        return s_free;
+    }
+
     constexpr int KE_OK = 0;
     constexpr int KE_ERROR = -1;
     constexpr int KE_ILLEGAL_PRIORITY = -403;
@@ -1176,7 +1186,17 @@ uint32_t EeScheduler::invocationStackTop()
         return existing->second;
     }
     constexpr uint32_t kInvocationStackSize = 0x4000u;
-    const uint32_t top = m_runtime.reserveAsyncCallbackStack(kInvocationStackSize, 16u);
+    uint32_t top = 0u;
+    auto &freeStacks = un4FreeInvocationStacks();
+    if (!freeStacks.empty())
+    {
+        top = freeStacks.back();
+        freeStacks.pop_back();
+    }
+    else
