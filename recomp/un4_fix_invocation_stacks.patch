+    // UN4Decomp: sem invocacoes ativas, as pilhas de invocacao desta thread voltam para reuso
+    auto &freeStacks = un4FreeInvocationStacks();
+    for (auto it = m_invocationStackTops.begin(); it != m_invocationStackTops.end();)
+    {
+        if (static_cast<int32_t>(static_cast<uint32_t>(it->first >> 32u)) == item.id)
