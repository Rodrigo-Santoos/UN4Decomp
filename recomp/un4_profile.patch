+// UN4Decomp: resume o pacote GIF que o VU1 mandou (quantas tags, PRIM, vertices XYZ) para ver se ele desenha algo
+static void un4LogXgkickPacket(const uint8_t *data, uint32_t size)
+{
+    static uint64_t s_n = 0;
+    ++s_n;
+    static uint32_t s_lines = 0;
+    const bool un4Print = (s_n <= 80u || ((s_n % 25u) <= 1u && s_lines < 1500u));
+    if (un4Print)
+        ++s_lines;
+    uint32_t off = 0, tags = 0, xyz = 0, prims = 0, ad = 0, adc = 0, colZero = 0, colNonZero = 0;
+    std::string fmts, firstVtx;
+    uint64_t lastPrim = ~0ull;
+    while (off + 16u <= size && tags < 64u)
+    {
+        uint64_t lo = 0, hi = 0;
+        std::memcpy(&lo, data + off, 8);
+        std::memcpy(&hi, data + off + 8, 8);
+        off += 16u;
+        ++tags;
+        const uint32_t nloop = static_cast<uint32_t>(lo & 0x7FFFu);
+        const uint32_t flg = static_cast<uint32_t>((lo >> 58) & 3u);
+        uint32_t nreg = static_cast<uint32_t>((lo >> 60) & 0xFu);
+        if (nreg == 0u)
+            nreg = 16u;
+        const bool eop = ((lo >> 15) & 1u) != 0u;
+        if ((lo >> 46) & 1u)
+        {
+            ++prims;
+            lastPrim = (lo >> 47) & 0x7FFu;
+        }
+        char buf[64];
+        std::snprintf(buf, sizeof(buf), " [f%u n%u r%u regs=%llx%s]", flg, nloop, nreg,
+                      static_cast<unsigned long long>(hi & ((nreg >= 16u) ? ~0ull : ((1ull << (nreg * 4u)) - 1u))), eop ? " eop" : "");
+        fmts += buf;
+        if (flg == 0u)
+        {
+            for (uint32_t l = 0; l < nloop; ++l)
+                for (uint32_t r = 0; r < nreg; ++r)
+                {
+                    if (off + 16u > size)
+                        break;
+                    const uint32_t desc = static_cast<uint32_t>((hi >> (r * 4u)) & 0xFu);
+                    if (desc == 0x1u)
+                    {
+                        uint64_t c0 = 0, c1 = 0;
+                        std::memcpy(&c0, data + off, 8);
+                        std::memcpy(&c1, data + off + 8, 8);
+                        if ((c0 | c1) == 0u)
+                            ++colZero;
+                        else
+                            ++colNonZero;
+                    }
+                    if (desc == 0x1u && firstVtx.size() < 300u)
+                    {
+                        uint64_t clo = 0, chi = 0;
+                        std::memcpy(&clo, data + off, 8);
+                        std::memcpy(&chi, data + off + 8, 8);
+                        char cb[48];
+                        std::snprintf(cb, sizeof(cb), " c(%u,%u,%u,%u)", static_cast<unsigned>(clo & 0xFFu),
+                                      static_cast<unsigned>((clo >> 32) & 0xFFu), static_cast<unsigned>(chi & 0xFFu),
+                                      static_cast<unsigned>((chi >> 32) & 0xFFu));
+                        firstVtx += cb;
+                    }
+                    if (desc == 0x4u || desc == 0x5u || desc == 0xCu || desc == 0xDu)
+                    {
+                        ++xyz;
+                        uint64_t vlo = 0, vhi = 0;
+                        std::memcpy(&vlo, data + off, 8);
+                        std::memcpy(&vhi, data + off + 8, 8);
+                        const bool vadc = ((vhi >> 47) & 1u) != 0u;
+                        if (vadc)
+                            ++adc;
+                        if (firstVtx.size() < 300u)
+                        {
+                            char vb[96];
+                            std::snprintf(vb, sizeof(vb), " v(x=%.1f y=%.1f z=%llx adc=%d)",
+                                          static_cast<double>(vlo & 0xFFFFu) / 16.0,
+                                          static_cast<double>((vlo >> 32) & 0xFFFFu) / 16.0,
+                                          static_cast<unsigned long long>(vhi & 0xFFFFFFFFull), vadc ? 1 : 0);
+                            firstVtx += vb;
+                        }
+                    }
+                    else if (desc == 0x0u)
+                        ++prims;
+                    else if (desc == 0xEu)
+                    {
+                        uint64_t v = 0, a = 0;
+                        std::memcpy(&v, data + off, 8);
+                        std::memcpy(&a, data + off + 8, 8);
+                        ++ad;
+                        const uint32_t reg = static_cast<uint32_t>(a & 0xFFu);
+                        if (reg == 0x00u) { ++prims; lastPrim = v & 0x7FFu; }
+                        if (reg == 0x04u || reg == 0x05u || reg == 0x0Cu || reg == 0x0Du)
+                            ++xyz;
+                    }
+                    off += 16u;
+                }
+        }
+        else if (flg == 1u)
+        {
+            const uint64_t words = static_cast<uint64_t>(nloop) * nreg;
+            for (uint64_t w = 0; w < words; ++w)
+            {
+                const uint32_t desc = static_cast<uint32_t>((hi >> ((w % nreg) * 4u)) & 0xFu);
+                if (desc == 0x4u || desc == 0x5u || desc == 0xCu || desc == 0xDu)
+                    ++xyz;
+                else if (desc == 0x0u)
+                    ++prims;
+            }
+            off += static_cast<uint32_t>(((words + 1u) & ~1ull) * 8u);
+        }
+        else
+            off += nloop * 16u;
+        if (eop)
+            break;
+    }
+    if (colZero > 0u && colNonZero > 0u && !g_un4DumpDone)
+    {
+        std::cerr << "[un4xg] pacote com cores misturadas #" << s_n << " zero=" << colZero << " cor=" << colNonZero
+                  << " -> registrando o estado do VU1" << std::endl;
+        un4DumpSnap();
+        g_un4DumpDone = true;
+    }
+    if (!un4Print)
+        return;
+    std::cerr << "[un4xg] #" << s_n << " bytes=" << size << " tags=" << tags << " prims=" << prims << " ultimoPrim=0x" << std::hex
+              << lastPrim << std::dec << " xyz=" << xyz << " adc=" << adc << " ad=" << ad << fmts.substr(0, 400) << firstVtx;
+    std::cerr << " qw0-2:";
+    for (uint32_t i = 0; i < 48u && i < size; i += 8u)
+    {
+        uint64_t v = 0;
+        std::memcpy(&v, data + i, 8);
+        std::cerr << ' ' << std::hex << v << std::dec;
+    }
+    std::cerr << std::endl;
+}
