+#define UN4_TRACE(nm)                                                                    \
+    do                                                                                   \
+    {                                                                                    \
+        static uint32_t s_un4TraceN = 0;                                                 \
+        if (++s_un4TraceN <= 8u || (s_un4TraceN % 600u) == 0u)                           \
+            ::un4prof::traceArgs(nm, s_un4TraceN, rdram, ctx);                           \
+    } while (0)
