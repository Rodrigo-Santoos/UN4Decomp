+    // UN4Decomp: medidor de CPU por amostragem (Linux/WSL). A cada 1 ms de CPU o sinal SIGPROF anota em que
+    // funcao do PC o programa estava; o resumo mostra onde o tempo esta indo (precisa do link com -rdynamic).
+    namespace cpu
+    {
+        constexpr uint32_t kSamples = 1u << 16;
+        inline uintptr_t *samples() { static uintptr_t buf[kSamples]; return buf; }
+        inline std::atomic<uint32_t> &head() { static std::atomic<uint32_t> v{0}; return v; }
+#if defined(__linux__)
+        inline void onSignal(int, siginfo_t *, void *uctx)
+        {
+            const auto *uc = static_cast<const ucontext_t *>(uctx);
+#if defined(__x86_64__)
+            const uintptr_t pc = static_cast<uintptr_t>(uc->uc_mcontext.gregs[REG_RIP]);
+#elif defined(__aarch64__)
+            const uintptr_t pc = static_cast<uintptr_t>(uc->uc_mcontext.pc);
+#else
+            const uintptr_t pc = 0;
+#endif
+            const uint32_t i = head().fetch_add(1u, std::memory_order_relaxed);
+            samples()[i & (kSamples - 1u)] = pc;
+        }
+#endif
+        inline void start()
+        {
+#if defined(__linux__)
+            static bool started = false;
+            if (started)
+                return;
+            started = true;
+            if (const char *off = std::getenv("UN4_CPUPROF"); off && off[0] == '0')
+                return;
+            struct sigaction sa{};
+            sa.sa_sigaction = &onSignal;
+            sa.sa_flags = SA_SIGINFO | SA_RESTART;
+            sigemptyset(&sa.sa_mask);
+            sigaction(SIGPROF, &sa, nullptr);
+            itimerval tv{};
+            tv.it_interval.tv_usec = 1000;
+            tv.it_value.tv_usec = 1000;
+            setitimer(ITIMER_PROF, &tv, nullptr);
+#endif
+        }
+        inline void dump()
+        {
+#if defined(__linux__)
+            static uint32_t last = 0;
+            const uint32_t now = head().load();
+            uint32_t n = now - last;
+            if (n > kSamples)
+                n = kSamples;
+            std::unordered_map<uintptr_t, uint32_t> bySym;
+            std::unordered_map<uintptr_t, std::string> names;
+            for (uint32_t k = 0; k < n; ++k)
+            {
+                const uintptr_t pc = samples()[(now - n + k) & (kSamples - 1u)];
+                Dl_info info{};
+                uintptr_t key = pc;
+                if (pc && dladdr(reinterpret_cast<void *>(pc), &info) && info.dli_saddr)
+                {
+                    key = reinterpret_cast<uintptr_t>(info.dli_saddr);
+                    if (!names.count(key))
+                    {
+                        std::string nm = info.dli_sname ? info.dli_sname : "?";
+                        int st = 0;
+                        if (char *dem = abi::__cxa_demangle(nm.c_str(), nullptr, nullptr, &st))
+                        {
+                            nm = dem;
+                            std::free(dem);
+                        }
+                        if (nm.size() > 90u)
+                            nm.resize(90u);
+                        const char *lib = info.dli_fname ? std::strrchr(info.dli_fname, '/') : nullptr;
+                        names[key] = nm + " [" + (lib ? lib + 1 : "?") + "]";
+                    }
+                }
+                else
+                {
+                    key = pc & ~static_cast<uintptr_t>(0xFFF);
+                    if (!names.count(key))
+                    {
+                        char tmp[64];
+                        std::snprintf(tmp, sizeof(tmp), "sem nome perto de %p", reinterpret_cast<void *>(key));
+                        names[key] = tmp;
+                    }
+                }
+                ++bySym[key];
+            }
+            last = now;
+            std::vector<std::pair<uint32_t, uintptr_t>> top;
+            for (const auto &e : bySym)
+                top.emplace_back(e.second, e.first);
+            std::sort(top.begin(), top.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+            std::cerr << "[un4cpu] " << n << " amostras (1 por ms de CPU, todas as threads):" << std::endl;
+            for (size_t i = 0; i < top.size() && i < 25u; ++i)
+                std::cerr << "[un4cpu]   " << (top[i].first * 100u / (n ? n : 1u)) << "% " << top[i].first << " "
+                          << names[top[i].second] << std::endl;
+#endif
+        }
+    }
+
+    inline void dumpGsCounters()
+    {
+        static uint64_t lastPk = 0, lastBy = 0, lastDr = 0;
+        const uint64_t pk = gifPackets().load(), by = gifBytes().load(), dr = gsDraws().load();
+        std::cerr << "[un4gs] no intervalo: pacotesGIF=" << (pk - lastPk) << " KB=" << ((by - lastBy) >> 10)
+                  << " desenhos=" << (dr - lastDr) << std::endl;
+        lastPk = pk; lastBy = by; lastDr = dr;
+    }
