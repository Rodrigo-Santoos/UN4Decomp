+// UN4Decomp: copia do estado do VU1 no inicio de cada execucao (para reproduzir fora do jogo)
+namespace
+{
+    struct Un4VuSnap
+    {
+        uint8_t code[16384];
+        uint8_t data[16384];
+        VU1State state;
+        bool resume;
+        uint32_t startPC, top, itop;
+        bool valid = false;
+    };
+    Un4VuSnap &un4Snap()
+    {
+        static Un4VuSnap s;
+        return s;
+    }
+    bool g_un4DumpRequested = false;
+    bool g_un4DumpDone = false;
+
+    void un4DumpSnap()
+    {
+        Un4VuSnap &s = un4Snap();
+        if (!s.valid)
+            return;
+        std::cerr << "[un4vu] inicio " << (s.resume ? "resume" : "execute") << " pc=0x" << std::hex << s.startPC << " top=0x" << s.top
+                  << " itop=0x" << s.itop << std::dec << std::endl;
+        auto dumpMem = [](const char *tag, const uint8_t *mem, uint32_t size)
+        {
+            for (uint32_t off = 0; off < size; off += 16u)
+            {
+                bool zero = true;
+                for (uint32_t i = 0; i < 16u; ++i)
+                    zero = zero && mem[off + i] == 0u;
+                if (zero)
+                    continue;
+                char line[64];
+                std::snprintf(line, sizeof(line), "[un4vu] %s %04x ", tag, off / 16u);
+                std::cerr << line;
+                for (uint32_t i = 0; i < 16u; ++i)
+                {
+                    char hx[4];
+                    std::snprintf(hx, sizeof(hx), "%02x", mem[off + i]);
+                    std::cerr << hx;
+                }
+                std::cerr << '\n';
+            }
+        };
+        dumpMem("c", s.code, sizeof(s.code));
+        dumpMem("d", s.data, sizeof(s.data));
+        const uint8_t *st = reinterpret_cast<const uint8_t *>(&s.state);
+        std::cerr << "[un4vu] s " << sizeof(VU1State) << " ";
+        for (size_t i = 0; i < sizeof(VU1State); ++i)
+        {
+            char hx[4];
+            std::snprintf(hx, sizeof(hx), "%02x", st[i]);
+            std::cerr << hx;
+        }
+        std::cerr << std::endl;
+    }
+
+    void un4TakeSnap(const uint8_t *code, uint32_t codeSize, const uint8_t *data, uint32_t dataSize, const VU1State &state,
+                     bool resume, uint32_t startPC, uint32_t top, uint32_t itop)
+    {
+        if (g_un4DumpDone)
+            return;
+        Un4VuSnap &s = un4Snap();
+        std::memcpy(s.code, code, std::min<uint32_t>(codeSize, sizeof(s.code)));
+        std::memcpy(s.data, data, std::min<uint32_t>(dataSize, sizeof(s.data)));
+        s.state = state;
+        s.resume = resume;
+        s.startPC = startPC;
+        s.top = top;
+        s.itop = itop;
+        s.valid = true;
+    }
+}
