+namespace un4prof
+{
+    // UN4Decomp: estado interno do leitor de streams da CRI (adxstm, 40 handles de 0x68 bytes em 0x416FA0),
+    // do driver de CD da CRI ("SRD", em 0x41DA58) e do carregador de arquivos do jogo (0x40B4A8).
+    inline void hexLine(const char *tag, const uint8_t *rdram, uint32_t addr, uint32_t size, const char *prefix = "[un4adx]")
+    {
+        static const char *digits = "0123456789abcdef";
+        std::string out;
+        out.reserve(size * 3u);
+        for (uint32_t i = 0; i < size; ++i)
+        {
+            if (i && (i % 4u) == 0u)
+                out.push_back(' ');
+            const uint8_t b = rdram[addr + i];
+            out.push_back(digits[b >> 4]);
+            out.push_back(digits[b & 15]);
+        }
+        std::cerr << prefix << ' ' << tag << " @0x" << std::hex << addr << std::dec << ": " << out << std::endl;
+    }
+
+    inline void dumpGuest(const uint8_t *rdram)
+    {
+        if (!rdram)
+            return;
+        for (uint32_t i = 0; i < 40u; ++i)
+        {
+            const uint32_t base = 0x416FA0u + i * 0x68u;
+            if (rdram[base] != 0u)
+            {
+                const std::string tag = "stm" + std::to_string(i);
+                hexLine(tag.c_str(), rdram, base, 0x68u);
+            }
+        }
+        hexLine("srd", rdram, 0x41DA58u, 0x90u);
+        auto rd32 = [&](uint32_t addr) -> uint32_t
+        {
+            uint32_t v = 0;
+            std::memcpy(&v, rdram + (addr & 0x1FFFFFFu), 4);
+            return v;
+        };
+        const uint32_t boot = rd32(0x609670u);
+        const uint32_t cri = rd32(0x6096F0u);
+        const uint32_t sys = rd32(0x609588u);
+        std::cerr << "[un4adx] boot: rofsPronto(D_6095EC)=" << int(rdram[0x6095ECu]) << " D_6095E8=" << int(rdram[0x6095E8u])
+                  << " cri(D_6096F0)=0x" << std::hex << cri << " cri+0x20=" << std::dec
+                  << int(cri ? rdram[(cri + 0x20u) & 0x1FFFFFFu] : 0xEEu) << " logos(D_609670)=0x" << std::hex << boot
+                  << " sys(D_609588)=0x" << sys << std::dec << std::endl;
+        if (boot)
+            hexLine("logos", rdram, boot & 0x1FFFFFFu, 0x18u);
+        {   // ultima mensagem de erro do CRI/ROFS (func_00120F98 escreve em D_0060BBF0) e o codigo (D_00409BD4)
+            char msg[129] = {};
+            std::memcpy(msg, rdram + 0x60BBF0u, 128u);
+            for (char &ch : msg)
+                if (ch != 0 && (ch < 0x20 || ch > 0x7E))
+                    ch = '.';
+            std::cerr << "[un4erro] cri/rofs codigo=" << static_cast<int32_t>(rd32(0x409BD4u)) << " msg=\"" << msg << "\"" << std::endl;
+        }
+        {   // modo do jogo depois do boot (D_00609650, usado pelo switch do MOTHER em 0x1C97D8)
+            const uint32_t mode = rd32(0x609650u);
+            std::cerr << "[un4modo] D_609650=0x" << std::hex << mode << std::dec << std::endl;
+            if (mode)
+                hexLine("modo", rdram, mode & 0x1FFFFFFu, 0x40u, "[un4modo]");
+            const uint32_t title = rd32(0x609658u);
+            if (title)
+            {
+                hexLine("titulo(D_609658)", rdram, title & 0x1FFFFFFu, 0x50u, "[un4modo]");
+                // objetos 3D da tela de titulo (+0x1C fundo, +0x2C/+0x30 aparecem na fase 4): alpha +0x88, malhas +0xFC
+                static const uint32_t kObjOffs[3] = {0x1Cu, 0x2Cu, 0x30u};
+                for (uint32_t oi = 0; oi < 3u; ++oi)
+                {
+                    const uint32_t obj = rd32((title + kObjOffs[oi]) & 0x1FFFFFFu) & 0x1FFFFFFu;
+                    if (!obj || obj >= 0x2000000u)
+                        continue;
+                    char lbl[48];
+                    std::snprintf(lbl, sizeof(lbl), "tobj+%X@%X", kObjOffs[oi], obj);
+                    hexLine(lbl, rdram, obj + 0x80u, 0x90u, "[un4obj]");
+                    const uint32_t info = rd32((obj + 0x90u) & 0x1FFFFFFu) & 0x1FFFFFFu;
+                    const uint32_t meshes = rd32((obj + 0xFCu) & 0x1FFFFFFu) & 0x1FFFFFFu;
+                    const uint32_t count = info ? rd32((info + 0x20u) & 0x1FFFFFFu) : 0u;
+                    for (uint32_t mi = 0; meshes && mi < count && mi < 4u; ++mi)
+                    {
+                        const uint32_t ent = meshes + mi * 16u;
+                        const uint32_t node = rd32(ent & 0x1FFFFFFu) & 0x1FFFFFFu;
+                        std::snprintf(lbl, sizeof(lbl), "tobj+%X.m%u tipo=%X", kObjOffs[oi], mi, rd32((ent + 8u) & 0x1FFFFFFu));
+                        if (node && node < 0x2000000u)
+                        {
+                            hexLine(lbl, rdram, node + 0x30u, 0x10u, "[un4obj] mundo.t");
+                            hexLine(lbl, rdram, node + 0x70u, 0x10u, "[un4obj] local.t");
+                            hexLine(lbl, rdram, node + 0x80u, 0x30u, "[un4obj] no");
+                        }
+                    }
+                }
+            }
+        }
+        if (sys)
+            hexLine("sys", rdram, sys & 0x1FFFFFFu, 0x90u);
+        if (boot)
+        {
+            // lista de telas de abertura: objeto+4 = {?, qtd, vetor}; mostra o vetor e cada item
+            const uint32_t list = rd32((boot + 0xCu) & 0x1FFFFFFu);
+            const uint32_t count = rd32((boot + 8u) & 0x1FFFFFFu);
+            std::cerr << "[un4adx] logos lista=0x" << std::hex << list << " qtd=" << std::dec << count << std::endl;
+            if (list && count && count < 32u)
+            {
+                hexLine("logos.vetor", rdram, list & 0x1FFFFFFu, count * 4u);
+                for (uint32_t i = 0; i < count; ++i)
+                {
+                    const uint32_t item = rd32((list + i * 4u) & 0x1FFFFFFu);
+                    if (item)
+                    {
+                        const std::string tag = "logos.item" + std::to_string(i);
+                        hexLine(tag.c_str(), rdram, item & 0x1FFFFFFu, 0x30u);
+                    }
+                }
+            }
+        }
+        hexLine("loader", rdram, 0x40B4A8u, 0x40u);
+        {   // UN4Decomp: player de video (fila de quadros D_006095B4, flags D_6095CC/D4/D8, objetos A0/A4/C8)
+            const uint32_t q = rd32(0x6095B4u), a0 = rd32(0x6095A0u), a4 = rd32(0x6095A4u), c8 = rd32(0x6095C8u);
+            std::cerr << "[un4mov] fila=0x" << std::hex << q << " A0=0x" << a0 << " A4=0x" << a4 << " C8=0x" << c8
+                      << " CC=" << rd32(0x6095CCu) << " D4=" << rd32(0x6095D4u) << " D8=" << rd32(0x6095D8u) << std::dec << std::endl;
+            if (q)
+                hexLine("fila", rdram, q & 0x1FFFFFFu, 0x30u, "[un4mov]");
+            if (c8)
+                hexLine("C8", rdram, c8 & 0x1FFFFFFu, 0x48u, "[un4mov]");
+            if (a0)
+                hexLine("A0", rdram, a0 & 0x1FFFFFFu, 0x40u, "[un4mov]");
+            if (a4)
+                hexLine("A4", rdram, a4 & 0x1FFFFFFu, 0x60u, "[un4mov]");
+            const uint32_t rb = rd32(0x60959Cu);
+            if (rb)
+                hexLine("ringbuf+60000", rdram, (rb + 0x60000u) & 0x1FFFFFFu, 0x20u, "[un4mov]");
+            std::cerr << "[un4mov] ringbuf=0x" << std::hex << rb << std::dec << std::endl;
+        }
+    }
+}
