+// UN4Decomp: registra registradores e campos do sprite num ponto exato de func_001C4AA0
+// (s5 = objeto, s1 = area de trabalho no scratchpad); so as 12 primeiras passagens por ponto.
+#define UN4_PEEK(tag)                                                                                          \
+    do                                                                                                         \
+    {                                                                                                          \
+        static uint32_t s_un4PeekN = 0;                                                                        \
+        if (++s_un4PeekN <= 12u)                                                                               \
+        {                                                                                                      \
