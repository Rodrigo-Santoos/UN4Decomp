+namespace un4prof
+{
+    // UN4Decomp: registra argumentos e o estado do objeto (a0) na entrada de funcoes escolhidas
+    template <class Ctx>
+    inline void traceArgs(const char *name, uint32_t n, const uint8_t *rdram, const Ctx *ctx)
+    {
+        auto rd32 = [&](uint32_t addr) -> uint32_t
+        {
+            uint32_t v = 0;
+            std::memcpy(&v, rdram + (addr & 0x1FFFFFFu), 4);
+            return v;
+        };
+        const uint32_t a0 = getRegU32(ctx, 4);
+        std::cerr << "[un4trace] " << name << " #" << n << std::hex << " pc=0x" << ctx->pc << " a0=0x" << a0 << " a1=0x" << getRegU32(ctx, 5)
+                  << " a2=0x" << getRegU32(ctx, 6) << " a3=0x" << getRegU32(ctx, 7) << " ra=0x" << getRegU32(ctx, 31)
+                  << " heap(548/544/550)=0x" << rd32(0x609548u) << "/0x" << rd32(0x609544u) << "/0x" << rd32(0x609550u);
+        const uint32_t sys = rd32(0x609588u);
+        if (sys)
+            std::cerr << " sys+1c0=0x" << rd32(sys + 0x1C0u);
+        if (a0 >= 0x100000u && a0 < 0x2000000u)
+        {
+            std::cerr << " obj:";
+            for (uint32_t off = 0; off < 0x40u; off += 4u)
+                std::cerr << ' ' << rd32(a0 + off);
+            std::cerr << " +d0=" << rd32(a0 + 0xD0u) << " +d8=" << rd32(a0 + 0xD8u);
+        }
+        std::cerr << std::dec << std::endl;
+    }
+}
