+    inline void dumpAll(uint64_t vblank)
+    {
+        std::lock_guard<std::mutex> lock(sitesMutex());
+        std::vector<std::pair<std::string, uint64_t>> active;
+        for (Site *site : sites())
+        {
+            const uint64_t delta = site->count - site->last;
+            if (delta)
+                active.emplace_back(site->name, delta);
+        }
+        std::sort(active.begin(), active.end());
+        std::cerr << "[un4all] vblank " << vblank << " " << active.size() << " funcoes:";
+        for (const auto &entry : active)
+            std::cerr << ' ' << entry.first << '=' << entry.second;
+        std::cerr << std::endl;
+    }
+
+    inline void dump(uint64_t vblank)
+    {
+        std::lock_guard<std::mutex> lock(sitesMutex());
+        std::vector<std::pair<uint64_t, Site *>> active;
+        std::vector<Site *> fresh;
+        for (Site *site : sites())
+        {
+            const uint64_t now = site->count;
+            const uint64_t delta = now - site->last;
+            site->last = now;
+            if (delta == 0u)
+                continue;
+            active.emplace_back(delta, site);
+            if (!site->seen)
+            {
+                site->seen = true;
+                fresh.push_back(site);
+            }
+        }
+        std::sort(active.begin(), active.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+        {
+            // ritmo da emulacao: no PS2 sao ~60 vblanks por segundo; menos que isso = jogo lento
+            using clock = std::chrono::steady_clock;
+            static const clock::time_point s_start = clock::now();
+            static clock::time_point s_last = s_start;
+            static uint64_t s_lastVblank = 0u;
+            const clock::time_point now = clock::now();
+            const double total = std::chrono::duration<double>(now - s_start).count();
+            const double interval = std::chrono::duration<double>(now - s_last).count();
+            const double rate = interval > 0.0 ? static_cast<double>(vblank - s_lastVblank) / interval : 0.0;
+            std::cerr << "[un4tempo] vblank " << vblank << " tempo=" << static_cast<int>(total) << "s ritmo="
+                      << static_cast<int>(rate + 0.5) << " vblanks/s (60 = velocidade normal)" << std::endl;
+            s_last = now;
+            s_lastVblank = vblank;
+        }
+        std::cerr << "[un4prof] vblank " << vblank << ": " << active.size() << " funcoes ativas, "
+                  << fresh.size() << " novas" << std::endl;
+        std::cerr << "[un4prof]   mais chamadas:";
+        for (size_t i = 0; i < active.size() && i < 30u; ++i)
+            std::cerr << ' ' << active[i].second->name << '=' << active[i].first;
+        std::cerr << std::endl;
+        std::cerr << "[un4prof]   novas:";
+        for (size_t i = 0; i < fresh.size() && i < 120u; ++i)
+            std::cerr << ' ' << fresh[i]->name;
+        if (fresh.size() > 120u)
+            std::cerr << " ...(+" << (fresh.size() - 120u) << ")";
+        std::cerr << std::endl;
+        // funcoes vigiadas (sequencia de boot / logos / ROFS)
+        {
+            static const char *watch[] = {"001C8E20", "001C84B0", "001C8200", "00151CC0", "00151BD0", "0011E2C0",
+                                          "001DAE60", "00151BC0", "001C94D0", "00120F98", "001075A0", "003F5B20",
+                                          "00315EE0", "001C8A60", "00348300", "00152420", "00152230",
+                                          "00105120", "001079C0", "00101290", "001011C0", "00105200",
+                                          "sceMpegGetPicture", "00100EC0", "00100F60", "001052D0",
+                                          "00103BC0", "sceMpegDemuxPssRing", "00104F00", "00103D40",
+                                          "001044C0", "00104620", "00100BB0", "001008A0", "00100540", "00100490",
+                                          "00101390", "00104240", "001042C0", "00101EA0", "00100E90", "00103B50",
+                                          "00104F50", "00108CA0", "00108E90", "001047C0",
+                                          "001C9300", "001C6AC0", "001C6C30", "003179D0", "00317DD0", "00317870",
+                                          "001C8200", "001C87A0", "001C9290"};
+            std::cerr << "[un4prof]   vigiadas:";
+            for (Site *site : sites())
+                for (const char *w : watch)
+                    if (std::strstr(site->name, w))
+                        std::cerr << ' ' << site->name << "=" << site->count;
+            std::cerr << std::endl;
+        }
+        // funcoes ativas com poucas chamadas: costumam ser a "etapa" atual do jogo (chamada 1x por quadro)
+        std::cerr << "[un4prof]   1x por quadro (~" << 300 << "):";
+        size_t shown = 0;
+        for (const auto &entry : active)
+        {
+            if (entry.first >= 250u && entry.first <= 350u && shown < 60u)
+            {
+                std::cerr << ' ' << entry.second->name;
+                ++shown;
+            }
+        }
+        std::cerr << std::endl;
+    }
+}
