+#pragma once
+// UN4Decomp: medidor simples de funcoes recompiladas.
+// Cada funcao do jogo conta quantas vezes foi chamada; a cada poucos segundos o runtime imprime
+// as mais chamadas no periodo e as que rodaram pela primeira vez (mostra em que etapa o jogo esta).
+#include <algorithm>
+#include <cstdint>
+#include <iostream>
+#include <mutex>
+#include <chrono>
+#include <atomic>
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+#include <unordered_map>
+#if defined(__linux__)
+#include <csignal>
+#include <cxxabi.h>
+#include <dlfcn.h>
+#include <sys/time.h>
+#include <ucontext.h>
+#endif
