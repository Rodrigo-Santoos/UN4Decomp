+// UN4Decomp: ponte de controle. O jogo roda dentro do WSL, que nao enxerga o controle USB do Windows.
+// Um script do lado do Windows (recomp/pad_bridge.ps1) le o controle pelo XInput e manda o estado por TCP
+// (uma linha de texto por leitura: "botoes gatilhoE gatilhoD lx ly rx ry"); aqui so guardamos o ultimo estado.
+namespace un4padbridge
+{
+    struct State
+    {
+        std::atomic<uint32_t> buttons{0};
+        std::atomic<int> lt{0}, rt{0}, lx{0}, ly{0}, rx{0}, ry{0};
+        std::atomic<int64_t> lastMs{0};
+    };
+
+    static State &state()
+    {
+        static State s;
+        return s;
+    }
+
+    static int64_t nowMs()
+    {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+#if !defined(_WIN32)
+    static void serve(int port)
+    {
+        const int srv = ::socket(AF_INET, SOCK_STREAM, 0);
+        if (srv < 0)
+            return;
+        int one = 1;
+        ::setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+        sockaddr_in addr{};
+        addr.sin_family = AF_INET;
+        addr.sin_addr.s_addr = htonl(INADDR_ANY);
+        addr.sin_port = htons(static_cast<uint16_t>(port));
+        if (::bind(srv, reinterpret_cast<sockaddr *>(&addr), sizeof(addr)) != 0 || ::listen(srv, 1) != 0)
+        {
+            std::cerr << "[un4pad] nao consegui abrir a porta " << port << " para a ponte do controle" << std::endl;
+            ::close(srv);
+            return;
+        }
+        std::cerr << "[un4pad] esperando a ponte do controle na porta " << port << std::endl;
+        for (;;)
+        {
+            const int cli = ::accept(srv, nullptr, nullptr);
+            if (cli < 0)
+                continue;
+            ::setsockopt(cli, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+            std::cerr << "[un4pad] ponte do controle conectada" << std::endl;
+            std::string pending;
+            char buf[512];
+            for (;;)
+            {
+                const ssize_t n = ::recv(cli, buf, sizeof(buf), 0);
+                if (n <= 0)
+                    break;
+                pending.append(buf, static_cast<size_t>(n));
+                size_t nl;
+                while ((nl = pending.find('\n')) != std::string::npos)
+                {
+                    unsigned btn = 0;
+                    int lt = 0, rt = 0, lx = 0, ly = 0, rx = 0, ry = 0;
+                    if (std::sscanf(pending.c_str(), "%u %d %d %d %d %d %d", &btn, &lt, &rt, &lx, &ly, &rx, &ry) == 7)
+                    {
+                        State &s = state();
+                        s.buttons = btn; s.lt = lt; s.rt = rt; s.lx = lx; s.ly = ly; s.rx = rx; s.ry = ry;
+                        s.lastMs = nowMs();
+                    }
+                    pending.erase(0, nl + 1);
+                }
+                if (pending.size() > 4096)
+                    pending.clear();
+            }
+            ::close(cli);
+            state().lastMs = 0;
+            std::cerr << "[un4pad] ponte do controle desconectada" << std::endl;
+        }
+    }
+#endif
+
+    static void ensureStarted()
+    {
+#if !defined(_WIN32)
+        static std::atomic<bool> started{false};
+        if (started.exchange(true))
+            return;
+        const char *env = std::getenv("UN4_PAD_PORT");
+        const int port = (env && *env) ? std::atoi(env) : 28862;
+        if (port > 0)
+            std::thread(serve, port).detach();
+#endif
+    }
+
+    // Verdadeiro quando a ponte mandou um estado ha menos de meio segundo.
+    static bool active()
+    {
+        const int64_t last = state().lastMs.load();
+        return last != 0 && (nowMs() - last) < 500;
+    }
+}
