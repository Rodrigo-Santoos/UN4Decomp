+    // UN4Decomp: procura um arquivo no diretorio ISO9660 da imagem real, para usar os LBNs reais
+    // (os mesmos que o IOP usa ao ler da imagem). Retorna false se nao houver imagem ou arquivo.
+    bool un4IsoLookup(const std::filesystem::path &image, const std::string &ps2Path, uint32_t &lbnOut, uint32_t &sizeOut)
+    {
+        if (image.empty())
+            return false;
+        std::ifstream iso(image, std::ios::binary);
+        if (!iso)
+            return false;
+        auto readSector = [&](uint32_t lba, uint8_t *dst) -> bool
+        {
+            iso.seekg(static_cast<std::streamoff>(lba) * 2048, std::ios::beg);
+            iso.read(reinterpret_cast<char *>(dst), 2048);
+            return static_cast<bool>(iso);
+        };
+        auto le32 = [](const uint8_t *b) -> uint32_t
+        { return b[0] | (b[1] << 8) | (b[2] << 16) | (static_cast<uint32_t>(b[3]) << 24); };
+        uint8_t sector[2048];
+        if (!readSector(16, sector) || sector[0] != 1 || std::memcmp(sector + 1, "CD001", 5) != 0)
+            return false;
+        uint32_t dirLba = le32(sector + 156 + 2);
+        uint32_t dirSize = le32(sector + 156 + 10);
+
+        std::string path = ps2Path;
+        const size_t colon = path.find(':');
+        if (colon != std::string::npos)
+            path = path.substr(colon + 1);
+        std::vector<std::string> parts;
+        std::string cur;
+        for (char c : path)
+        {
+            if (c == '\\' || c == '/')
+            {
+                if (!cur.empty())
+                    parts.push_back(cur);
+                cur.clear();
+            }
+            else
+                cur.push_back(static_cast<char>(std::toupper(static_cast<unsigned char>(c))));
+        }
+        if (!cur.empty())
+            parts.push_back(cur);
+        if (parts.empty())
+            return false;
+        for (std::string &part : parts)
+        {
+            const size_t semi = part.find(';');
+            if (semi != std::string::npos)
+                part.resize(semi);
+        }
+
+        for (size_t i = 0; i < parts.size(); ++i)
+        {
+            const bool last = (i + 1 == parts.size());
+            bool found = false;
+            const uint32_t sectors = (dirSize + 2047) / 2048;
+            for (uint32_t s = 0; s < sectors && !found; ++s)
+            {
+                if (!readSector(dirLba + s, sector))
+                    return false;
+                uint32_t off = 0;
+                while (off < 2048)
+                {
+                    const uint8_t len = sector[off];
+                    if (len == 0 || off + len > 2048)
+                        break;
+                    const uint8_t nameLen = sector[off + 32];
+                    std::string name(reinterpret_cast<const char *>(sector + off + 33), nameLen);
+                    const size_t semi = name.find(';');
+                    if (semi != std::string::npos)
+                        name.resize(semi);
+                    if (!name.empty() && name.back() == '.')
+                        name.pop_back();
+                    for (char &c : name)
+                        c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+                    const bool isDir = (sector[off + 25] & 2) != 0;
+                    if (nameLen > 1 && name == parts[i] && isDir != last)
+                    {
+                        dirLba = le32(sector + off + 2);
+                        dirSize = le32(sector + off + 10);
+                        found = true;
+                        break;
+                    }
+                    off += len;
+                }
+            }
+            if (!found)
+                return false;
+        }
+        lbnOut = dirLba;
+        sizeOut = dirSize;
+        return true;
+    }
