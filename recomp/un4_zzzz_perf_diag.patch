+// UN4Decomp (diagnostico): grava as entradas de N execucoes do VU1 (codigo, dados e registradores no inicio de
+// cada microprograma) num arquivo, para testar fora do jogo um interpretador mais rapido contra este.
+std::atomic<int> g_un4Vu1CaptureLeft{0};
+void un4Vu1CaptureRequest(int count)
+{
+    g_un4Vu1CaptureLeft.store(count);
+}
+
+namespace
+{
+    void un4Vu1Capture(const uint8_t *code, uint32_t codeSize, const uint8_t *data, uint32_t dataSize, const VU1State &state,
+                       bool resumed, uint32_t startPC, uint32_t top, uint32_t itop)
+    {
+        if (g_un4Vu1CaptureLeft.load(std::memory_order_relaxed) <= 0)
+            return;
+        static std::FILE *file = nullptr;
+        static uint64_t lastCodeHash = 0;
+        static int fileIndex = 0;
+        if (!file)
+        {
+            const char *dir = std::getenv("UN4_GSDUMP_DIR");
+            const std::string path = std::string(dir && *dir ? dir : ".") + "/vu1cap_" + std::to_string(++fileIndex) + ".bin";
+            file = std::fopen(path.c_str(), "wb");
+            if (!file)
+            {
+                g_un4Vu1CaptureLeft.store(0);
+                return;
+            }
+            lastCodeHash = 0;
+            std::cerr << "[un4vu1cap] gravando execucoes do VU1 em " << path << std::endl;
+        }
+        uint64_t hash = 1469598103934665603ull;
+        for (uint32_t i = 0; i < codeSize; i += 8u)
+        {
+            uint64_t w;
+            std::memcpy(&w, code + i, 8);
+            hash = (hash ^ w) * 1099511628211ull;
+        }
+        const uint32_t hasCode = (hash != lastCodeHash) ? 1u : 0u;
+        lastCodeHash = hash;
+        const uint32_t header[8] = {0x43315556u, resumed ? 1u : 0u, startPC, top, itop, codeSize, dataSize, hasCode};
+        const uint32_t stateSize = static_cast<uint32_t>(sizeof(VU1State));
+        std::fwrite(header, 1, sizeof(header), file);
+        std::fwrite(&stateSize, 1, 4, file);
+        std::fwrite(&state, 1, sizeof(VU1State), file);
+        if (hasCode)
+            std::fwrite(code, 1, codeSize, file);
+        std::fwrite(data, 1, dataSize, file);
+        if (g_un4Vu1CaptureLeft.fetch_sub(1) <= 1)
+        {
+            std::fclose(file);
+            file = nullptr;
+            std::cerr << "[un4vu1cap] gravacao terminada" << std::endl;
+        }
+    }
+}
