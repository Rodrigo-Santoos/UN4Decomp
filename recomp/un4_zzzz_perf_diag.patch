+// UN4Decomp (diagnostico): quanto de CPU cada thread do processo gastou desde o ultimo relatorio.
+static void un4ReportThreadCpu()
+{
+#if defined(__linux__)
+    struct Entry { unsigned long long ticks = 0; std::string name; };
+    static std::unordered_map<int, Entry> s_last;
+    static auto s_lastWall = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    const double wall = std::chrono::duration<double>(now - s_lastWall).count();
+    s_lastWall = now;
+    std::vector<std::pair<unsigned long long, std::string>> rows;
+    std::error_code ec;
+    for (const auto &dirEntry : std::filesystem::directory_iterator("/proc/self/task", ec))
+    {
+        const int tid = std::atoi(dirEntry.path().filename().c_str());
+        std::ifstream f(dirEntry.path() / "stat");
+        std::string line;
+        if (!std::getline(f, line))
+            continue;
+        const size_t open = line.find('('), close = line.rfind(')');
+        if (open == std::string::npos || close == std::string::npos)
+            continue;
+        const std::string name = line.substr(open + 1, close - open - 1);
+        std::istringstream rest(line.substr(close + 2));
+        std::string tok;
+        unsigned long long utime = 0, stime = 0;
+        for (int field = 3; field <= 15 && (rest >> tok); ++field)
+        {
+            if (field == 14) utime = std::strtoull(tok.c_str(), nullptr, 10);
+            if (field == 15) stime = std::strtoull(tok.c_str(), nullptr, 10);
+        }
+        Entry &e = s_last[tid];
+        const unsigned long long total = utime + stime;
+        const unsigned long long delta = total - e.ticks;
+        e.ticks = total;
+        if (delta)
+            rows.emplace_back(delta, name + "/" + std::to_string(tid));
+    }
+    std::sort(rows.begin(), rows.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+    const double hz = static_cast<double>(sysconf(_SC_CLK_TCK));
+    std::cerr << "[un4threads] " << wall << "s de relogio; thread do EE=" << static_cast<int>(::gettid()) << "; CPU por thread:";
+    for (size_t i = 0; i < rows.size() && i < 12u; ++i)
+        std::cerr << ' ' << rows[i].second << '=' << static_cast<int>(100.0 * (rows[i].first / hz) / (wall > 0 ? wall : 1)) << '%';
+    std::cerr << std::endl;
+#endif
+}
